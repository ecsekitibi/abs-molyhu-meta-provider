# Copy this file to .env and replace AUTH_TOKEN with a private random value.
TZ=Country/City
AUTH_TOKEN=replace-with-a-long-random-token

# Optional tuning
ABS_MOLY_PORT=8787
MAX_RESULTS=5
MIN_INTERVAL=1.0
CACHE_TTL=86400
REQUEST_TIMEOUT=20
MOLY_BASE_URL=https://moly.hu
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0
